NODE_ENV=development
PORT=3000
HOST=0.0.0.0

DATABASE_URL=postgresql://ace_user:ace_password@localhost:5432/ace_platform
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ace_platform
DB_USER=ace_user
DB_PASSWORD=ace_password
DB_SSL=false

JWT_SECRET=super_secret_jwt_key_for_ace_education_platform_2026
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_2026
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=20

CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
LOG_FILE=logs/ace-platform.log
PDF_TEMP_DIR=./tmp/pdfs

# AI Engine (for the Adaptive Mock Quiz & Study Plan)
# provider = groq, gemini or openai
AI_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
