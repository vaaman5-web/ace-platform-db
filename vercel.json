{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm ci && npm run build",
  "outputDirectory": "public/app",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/app/:path*", "destination": "/app/index.html" },
    { "source": "/app", "destination": "/app/index.html" }
  ]
}
